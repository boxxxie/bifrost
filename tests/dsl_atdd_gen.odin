	dispatch_steps_are: proc(expected: []bifrost.Dispatch_Step, loc := #caller_location),
	node_clip_is: proc(id: string, expected: bifrost.Rect, loc := #caller_location),
	persisted_scroll_is: proc(id: string, offset_y: i32, max_y: i32, loc := #caller_location),
