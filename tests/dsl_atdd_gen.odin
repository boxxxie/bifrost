	parsed_kitty_key_at_is: proc(idx: int, expected_cp: rune, expected_shifted: rune, expected_base: rune, expected_mods: bifrost.Mod_Flags, expected_action: bifrost.Key_Action, expected_text: string, loc := #caller_location),
	parsed_mouse_at_is: proc(idx: int, expected_col: i16, expected_row: i16, expected_button: bifrost.Mouse_Button, expected_action: bifrost.Mouse_Action, expected_mods: bifrost.Mod_Flags = {}, loc := #caller_location),
