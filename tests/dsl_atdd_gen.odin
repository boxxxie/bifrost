	typing_text: proc(text: string),
	parsing_raw_slice: proc(raw: string, is_timeout: bool = false),
	feeding_stream_chunk: proc(chunk: string, is_timeout: bool = false),
	feeding_byte_by_byte: proc(stream: string),
	worker_transacting_script: proc(script: string, tag_name: string = ""),
	worker_committing_batch: proc(map_name: string, key_prefix: string, start_id: int, count: int, sorted: bool = true, tag_name: string = ""),
	worker_running_datalog: proc(query_source: string),
	worker_diffing_moments: proc(moment_a: i64, moment_b: i64),
	sending_commit_burst: proc(count: int),
	sending_ui_msg: proc(msg: bifrost.UI_Msg),
	ticking_ui_frame: proc(tick_ns: i64 = 1),
	requesting_focus: proc(id: string),
	clicking_widget: proc(id: string, loc := #caller_location),
	sending_ui_key: proc(code: bifrost.Key_Code, ch: rune = 0, ctrl: bool = false, alt: bool = false, shift: bool = false),
	typing_ui_keys: proc(text: string),
	issuing_ui_side_effects: proc(focus_id: string, osc52_text: string, title: string, cursor_shape: bifrost.Cursor_Shape, request_quit: bool),
	pressing_mouse_on_ui_widget: proc(id: string, loc := #caller_location),
	sending_ui_focus_event: proc(focused: bool),
	customizing_ui_workspace: proc(splitter_id: string, split_size: i32, scope_id: string, child_id: string, leaf_id: string),
	saving_ui_workspace: proc(workspace_id: string, loc := #caller_location),
	writing_to_terminal_pipe: proc(data: string),
	feeding_win32_console_record: proc(rec: bifrost.Win32_Console_Record),
	pasting_text: proc(text: string),
	clicking_tab: proc(id: string, tab_idx: int, loc := #caller_location),
	flushing_and_loading_heimdall_segments: proc(loc := #caller_location),
	filtering_heimdall_store: proc(kind_filter: bifrost.Heimdall_Filter_Kind, scope_filter: string = "", query: string = "", loc := #caller_location),
}

