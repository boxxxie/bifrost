Given_DSL :: struct {
	terminal: proc(t: ^testing.T, w: i32 = 80, h: i32 = 24),
	focused_widget: proc(id: string),
	widget_consumes_at: proc(id: string, phase: bifrost.Event_Phase),
	clean_input_stream: proc(),
	actor_xitdb_inspector: proc(t: ^testing.T, w: i32 = 80, h: i32 = 24, num_workers: int = 2, active_collection: string = ""),
	chord_bound: proc(chord_spec: string, action_name: string, policy: bifrost.Key_Scope_Policy = .Root_And_Scopes, scope_id: string = "", loc := #caller_location),
	action_guard: proc(action_name: string, guard: bifrost.Action_Guard_Proc, userdata: rawptr = nil),
	action_availability: proc(action_name: string, avail: bifrost.Action_Availability, avail_proc: bifrost.Action_Avail_Proc = nil, userdata: rawptr = nil),
	actor_action_bound_static: proc(action_name: string, payload: bifrost.Xitdb_Worker_Msg, loc := #caller_location),
	actor_action_bound_dynamic: proc(action_name: string, builder_fn: proc(coord: ^bifrost.UI_Coordinator_State, userdata: rawptr) -> (bifrost.Xitdb_Worker_Msg, bool), userdata: rawptr = nil, loc := #caller_location),
	ui_quit_filter: proc(filter_fn: bifrost.UI_Quit_Filter_Fn, user_ptr: rawptr = nil),
	xitdb_array_list_populated: proc(list_name: string, count: int, step_multiplier: i64 = 10, expected_moment: i64 = 0, loc := #caller_location),
	nonblocking_pipe_terminal: proc(loc := #caller_location),
	text_area_text: proc(id: string, text: string),
	active_tab: proc(id: string, tab_idx: int, restore_body_focus: bool = true),
	heimdall_recorder: proc(sub_dir: string, bind_explicit: bool = true, set_default: bool = false, loc := #caller_location),
}

@(rodata)
given := Given_DSL{
	terminal = given_terminal_ambient,
	focused_widget = given_focused_widget_ambient,
	widget_consumes_at = given_widget_consumes_at_ambient,
	clean_input_stream = given_clean_input_stream_ambient,
	actor_xitdb_inspector = given_actor_xitdb_inspector_ambient,
